# Copy to .env and fill in. Nothing here is required to run locally: without keys the app runs in clearly
# labeled offline (no AI model) and simulated (no PayPal) modes. The app reads .env by itself; values already
# set in your shell or on your host win.
RDS_PUBLIC_URL=http://localhost:8000

# AI models. Claude Sonnet is the default; Claude Haiku can be picked per conversation.
# Google Gemini is off the menu because it was not part of the recorded comparison; RDS_ENABLE_GEMINI=1 brings it back.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
RDS_ASSISTANT=claude-sonnet
RDS_GEMINI_MODEL=gemini-flash-latest
RDS_HAIKU_MODEL=claude-haiku-5-5
RDS_MODEL=claude-sonnet-5-5

# PayPal sandbox: one app per demo shop.
PAYPAL_BASE=https://api-m.sandbox.paypal.com
PAYPAL_LYDIA_CLIENT_ID=
PAYPAL_LYDIA_CLIENT_SECRET=
PAYPAL_MARTHA_CLIENT_ID=
PAYPAL_MARTHA_CLIENT_SECRET=
PAYPAL_PRISCILLA_CLIENT_ID=
PAYPAL_PRISCILLA_CLIENT_SECRET=
# Sandbox apps for the shops that joined later. Without the first two pairs, Copper Kettle's and Sage & Stone's checkout is simulated.
# The last two shops' seals are withdrawn, so their checkout stays off either way.
PAYPAL_COPPER_KETTLE_SUPPLY_CLIENT_ID=
PAYPAL_COPPER_KETTLE_SUPPLY_CLIENT_SECRET=
PAYPAL_SAGE_STONE_STUDIO_CLIENT_ID=
PAYPAL_SAGE_STONE_STUDIO_CLIENT_SECRET=
PAYPAL_VIOLET_VINE_HOME_CLIENT_ID=
PAYPAL_VIOLET_VINE_HOME_CLIENT_SECRET=
PAYPAL_JUNIPER_OAK_GOODS_CLIENT_ID=
PAYPAL_JUNIPER_OAK_GOODS_CLIENT_SECRET=
# Webhook IDs from each app's Webhooks page; needed to verify webhook signatures (PAYPAL_WEBHOOK_ID is the fallback).
PAYPAL_LYDIA_WEBHOOK_ID=
PAYPAL_MARTHA_WEBHOOK_ID=
PAYPAL_PRISCILLA_WEBHOOK_ID=

# 32 random bytes as hex. Keep it stable in production so issued seals keep verifying.
RDS_ISSUER_SEED_HEX=
RDS_VAR_DIR=./var
# Demo owners' password (public on purpose; their studios hold sandbox data only).
RDS_DEMO_PASSWORD=demo-owner
# Set to enable seal withdrawal (POST /api/admin/merchants/{id}/withdraw) and key rotation.
RDS_ADMIN_TOKEN=
# Hours between automatic refreshes of every record; 0 turns it off.
RDS_REFRESH_HOURS=24
